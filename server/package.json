{
  "name": "uyir-server",
  "version": "1.0.0",
  "private": true,
  "description": "Uyir nurse registration API (Express 5, PostgreSQL on RDS, documents on S3).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/index.js",
    "dev": "node --env-file-if-exists=../.env --watch src/index.js",
    "seed": "node --env-file-if-exists=../.env scripts/seed.js",
    "seed:demo": "node --env-file-if-exists=../.env scripts/seed.js --reset --demo",
    "create-admin": "node --env-file-if-exists=../.env scripts/create-admin.js",
    "migrate:sqlite": "node --env-file-if-exists=../.env --disable-warning=ExperimentalWarning scripts/migrate-from-sqlite.js",
    "migrate:s3": "node --env-file-if-exists=../.env scripts/move-documents-to-s3.js",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  }
}
