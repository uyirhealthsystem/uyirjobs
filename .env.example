# Copy to your deployment's environment (ECS task definition). Secrets → AWS Secrets Manager.
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://uyirjobs.in

# Database: RDS / Aurora PostgreSQL (Multi-AZ). Inject credentials from Secrets Manager.
DATABASE_URL=postgres://uyir_app:<password>@<rds-endpoint>:5432/uyir
DATABASE_SSL=1
# Amazon RDS CA bundle: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DATABASE_CA_FILE=/app/certs/rds-global-bundle.pem
# Per task. Keep (tasks × PG_POOL_MAX) well under the instance's max_connections, or put RDS Proxy in front.
PG_POOL_MAX=10

# Document storage
STORAGE_DRIVER=s3
S3_BUCKET=uyirjobs-documents-prod
AWS_REGION=ap-south-1
S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:<account>:key/<key-id>
S3_PREFIX=documents/
S3_URL_TTL=60
HEALTH_CHECK_STORAGE=0

# Secrets (inject from Secrets Manager, never commit)
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENC_KEY=

# Messaging (see docs/WHATSAPP.md): invite by SMS with a WhatsApp chat link; everything else on WhatsApp.
WHATSAPP_BUSINESS_NUMBER=91XXXXXXXXXX
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LANG=en
# Secrets (Secrets Manager):
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Optional
# LOG_LEVEL=info              JSON logs to stdout (CloudWatch)
# TRUST_PROXY=1               proxies in front of the app (the ALB)
# SESSION_DAYS=7              staff sign-in lifetime
# S3_SSE=aws:kms              never 'none' in production
# S3_ENDPOINT=                MinIO / LocalStack (development only)
